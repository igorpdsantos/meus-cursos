DATABASE=escola
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=trocar-aqui

# APAGA E RECRIA TODAS AS TABELAS A CADA BOOT (igual ao ddl-auto: create-drop
# do Spring/JPA). Só para estudo — em produção isso destrói o banco.
DB_SYNC_FORCE=true

# Segredo que assina os tokens. Trocar este valor invalida todos os tokens já
# emitidos.
TOKEN_SECRET=gere-um-segredo-longo-e-aleatorio
TOKEN_EXPIRATION=7d

# Usada para montar a URL pública das fotos.
APP_URL=http://localhost:3001
