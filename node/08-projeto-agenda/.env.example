# Copie para .env e preencha com os seus valores.
#   cp .env.example .env
# O .env real está no .gitignore e nunca vai para o GitHub.

# Única variável lida pelo projeto (server.js: mongoose.connect + MongoStore)
CONNECTIONSTRING="mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net/AGENDA?retryWrites=true&w=majority"

# Opcional: hoje o segredo da sessão está fixo no server.js.
# Para usar daqui, troque a linha do secret por process.env.SESSION_SECRET
# SESSION_SECRET="gere-com-crypto-randomBytes-48-hex"
