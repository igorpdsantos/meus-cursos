<%- include('includes/head'); %>

<div class="text-center mb-4">
  <h1 class="titulo-pagina display-3">Criar conta ou Entrar</h1>
  <p class="lead text-muted mb-0">Faça login ou crie sua conta abaixo</p>
</div>

<div class="row justify-content-center">
  <div class="col-md-6">
    <h2 class="h3">Faça seu cadastro</h2>
    <p class="text-muted">Se você ainda não tem conta, preencha o formulário abaixo:</p>

    <form action="/login/register" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="mb-3">
        <label class="form-label" for="cadastro-email">Seu e-mail</label>
        <input type="email" name="email" id="cadastro-email" class="form-control">
      </div>

      <div class="mb-3">
        <label class="form-label" for="cadastro-senha">Sua senha</label>
        <input type="password" name="password" id="cadastro-senha" class="form-control">
      </div>

      <button type="submit" class="btn btn-primary">Criar minha conta</button>
    </form>
  </div>

  <div class="col-md-6">
    <h2 class="h3">Faça seu login</h2>
    <p class="text-muted">Se você já tem uma conta, faça login abaixo:</p>

    <form action="/login/login" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="mb-3">
        <label class="form-label" for="login-email">Seu e-mail</label>
        <input type="email" name="email" id="login-email" class="form-control">
      </div>

      <div class="mb-3">
        <label class="form-label" for="login-senha">Sua senha</label>
        <input type="password" name="password" id="login-senha" class="form-control">
      </div>

      <button type="submit" class="btn btn-primary">Entrar</button>
    </form>
  </div>
</div>

<%- include('includes/footer'); %>
