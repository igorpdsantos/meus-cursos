# Copie para .env e preencha com os seus valores.
#   cp .env.example .env
# O .env real está no .gitignore e nunca vai para o GitHub.

MONGODB_USERNAME="<usuario>"
MONGODB_PASSWORD="<senha>"
MONGODB_URI="mongodb+srv://<usuario>:<senha>@<cluster>.mongodb.net"
MONGODB_DBNAME="nome-do-banco"

# Qualquer string longa e aleatória. Gere uma com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="troque-por-uma-string-aleatoria-longa"
